# Supabase → Project Settings → API (or "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Google Cloud → APIs & Services → Credentials. Server-only.
GOOGLE_PLACES_API_KEY=your-places-api-key

# Optional: comma-separated Places primary types used to filter autocomplete (max 5).
# PLACES_AUTOCOMPLETE_TYPES=restaurant,cafe,bar,bakery,meal_takeaway
